{
  "name": "anchor-watch",
  "private": true,
  "version": "1.0.0",
  "description": "Anchor watch app — distance, depth, and wind via Signal K",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "agent": "npm --prefix boat-agent start",
    "agent:demo": "npm --prefix boat-agent run demo",
    "cloud:local": "npm run build && npm --prefix server start"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
