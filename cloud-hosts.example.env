# Copy to fly-secrets.local.env (or cloud-secrets.local.env) and fill in.
# Same BOAT_TOKEN / VIEW_TOKEN on Fly and Suga makes switching only a CLOUD_URL change.

BOAT_TOKEN=replace-me
VIEW_TOKEN=replace-me
BOAT_NAME=Breeze

# Active cloud host for boat agent / scripts: fly | suga
CLOUD_HOST=fly

CLOUD_URL_FLY=https://breeze-anchor-watch.fly.dev
# Paste the HTTPS URL Suga shows after you enable public networking (no trailing slash)
CLOUD_URL_SUGA=https://YOUR-SERVICE-production.xxxx.suga-xxxx.com
